<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        <div class="card-img-container">
          {%
            include figure.liquid
            loading="eager"
            path=project.img
            sizes = "250px"
            alt="project thumbnail"
            class="card-img-top"
          %}
        </div>
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        
        {% if project.tech_stack %}
          <div class="tech-stack-tags mb-2">
            {% assign tech_items = project.tech_stack | split: ", " %}
            {% for tech in tech_items limit:4 %}
              <span class="badge badge-pill badge-light">{{ tech }}</span>
            {% endfor %}
            {% if tech_items.size > 4 %}
              <span class="badge badge-pill badge-light">+{{ tech_items.size | minus: 4 }}</span>
            {% endif %}
          </div>
        {% endif %}
        
        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer">
                  <i class="fa-brands fa-github gh-icon"></i>
                </a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
